# Template for the publishing credentials. Copy to .env and fill in (.env is git-ignored).
#   cp .env.example .env   then edit, then:  source .env
# See PUBLISHING.md for how to obtain each value.

# Sonatype Central Portal user token (Account -> Generate User Token).
export ORG_GRADLE_PROJECT_mavenCentralUsername="<central portal token username>"
export ORG_GRADLE_PROJECT_mavenCentralPassword="<central portal token password>"

# GPG signing key. signingInMemoryKey is the full armored private key; the publishing key
# has no passphrase, so the password stays empty.
export ORG_GRADLE_PROJECT_signingInMemoryKey="$(cat ./earshot-signing-key.asc)"
export ORG_GRADLE_PROJECT_signingInMemoryKeyPassword=""
